# Frontend env — copy to apps/rfc/frontend/.env and adjust. Only VITE_-prefixed
# vars are exposed to the browser (Vite convention).
#
#   cp .env.example .env

# ── Backend endpoint ────────────────────────────────────────────────────────
# Where the browser sends API calls (/api/draft, /api/review, /api/document, …).
#
#   empty  → relative /api/... : uses the Vite dev proxy in dev, or the same
#            origin in production (frontend and backend served together).
#   URL    → absolute backend, when the SPA is hosted separately from the API.
#
# Examples:
#   VITE_API_BASE_URL=http://localhost:3001
#   VITE_API_BASE_URL=https://rfc-api.internal.example.com
VITE_API_BASE_URL=

# ── Dev proxy target (dev only) ─────────────────────────────────────────────
# Where `npm run dev` proxies /api. Leave empty to use the local backend.
# Only matters if you keep VITE_API_BASE_URL empty but run the backend elsewhere.
# VITE_DEV_PROXY_TARGET=http://localhost:3001
