# ── LLM provider (OpenAI-compatible /chat/completions) ──────────────────────
# The AI-draft feature works with any provider that exposes an OpenAI-compatible
# Chat Completions API. Copy this file to apps/mop/backend/.env and fill in one provider.
#
#   cp .env.example .env
#
# Providers can also be managed at runtime in the app itself: the LLM dashboard
# (⚙ Pengaturan LLM in the header) stores providers + API keys in
# LLM_CONFIG_PATH (compose: /data/llm-config.json on the rfc-data volume) and
# can assign a different provider per task (draft vs review). The env vars
# below remain as a fallback provider ("Konfigurasi .env") — leave them blank
# if you only manage providers in the dashboard.

# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# Qwen (Alibaba DashScope, compatible mode)
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=qwen-plus

# GLM / Zhipu
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=...
# LLM_MODEL=glm-4-plus

# Anthropic (OpenAI-compatible endpoint)
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-4-8

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Local / self-hosted (Ollama or LM Studio — keeps all data on-prem).
# From inside docker compose, reach the host with http://host.docker.internal:<port>/v1.
# LLM_BASE_URL=http://localhost:11434/v1     # Ollama
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b
# LLM_BASE_URL=http://localhost:1234/v1      # LM Studio (model id = the model loaded in LM Studio)
# LLM_API_KEY=<LM Studio API token, if auth is enabled>

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Max in-flight LLM calls to the env-var provider (1–16). 1 = one at a time
# (default; safe for local models like LM Studio that serve a single request).
# Raise it for hosted providers that accept parallel requests — the per-section
# review then runs several sections at once. Ignored for providers managed in
# the dashboard (each has its own Konkurensi setting there).
LLM_CONCURRENCY=1

# ── Google Docs export (per-user OAuth) ─────────────────────────────────────
# Lets the app create the MOP as a native Google Doc in the engineer's own Drive.
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# - Enable the "Google Drive API" for the project.
# - Authorized redirect URI (dev):  http://localhost:5173/api/google/callback
#   (add your production URL too when you deploy)
# - OAuth consent screen: add your engineers as Test users (or publish internally).
# Scope used: drive.file (the app can only touch files it creates).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Override only if your redirect URI differs from the dev default above:
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback

# ── Vector store (optional — semantic search over approved MOPs) ─────────────
# When set, the AI draft/review features retrieve few-shot examples by meaning
# (via Qdrant) instead of exact changeType/system field matching, surfacing
# kin systems ("Alibaba Cloud PolarDB" ~ "Alibaba Cloud ECS") and older
# approved forms beyond the last 50. Leave blank to keep the SQL fallback.
#
# Self-hosted stack (docker compose brings up qdrant + ollama): after first
# `up`, pull the embedding model once:
#   docker compose exec ollama ollama pull bge-m3
# then bootstrap the index:
#   cd backend && node scripts/seed-vector.js
#
# bge-m3 is multilingual (handles Bahasa Indonesia) and produces 1024-dim vectors.
QDRANT_URL=http://qdrant:6333
EMBED_BASE_URL=http://ollama:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3
# EMBED_DIM=1024

# Example (self-hosted via docker compose):
# QDRANT_URL=http://qdrant:6333
# EMBED_BASE_URL=http://ollama:11434/v1
# EMBED_API_KEY=ollama
# EMBED_MODEL=bge-m3

# ── Historical MOP corpus (optional, future) ────────────────────────────────
# MOP has no PDF import pipeline yet (unlike RFC). To bootstrap the few-shot
# corpus, drop hand-curated example JSONs into apps/mop/backend/fixtures/. The
# examples.js loader picks them up automatically; no LLM classification step.

