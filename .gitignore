policy/pdfs/
policy/parsed/
# Per-browser Google OAuth tokens (dev-mode file store).
apps/*/backend/gtokens.json
# LLM provider config incl. API keys (dev-mode file store, see llm-config.js).
apps/*/backend/llm-config.json

# Local compose overrides (e.g. pointing at an external qdrant).
docker-compose.override.yml
